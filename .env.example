# clone to .env
POSTGRES_USER=anchorfish
POSTGRES_PASSWORD=anchorfish
POSTGRES_DB=anchorfish
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://anchorfish:anchorfish@127.0.0.1:5432/anchorfish

# leave blank: the server makes a random one on first start
JWT_SECRET=
JWT_MINUTES=30

# seed accounts: leave blank and scripts.seed makes random ones
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=

SEED_JOEY_PASSWORD=
SEED_SIENNA_PASSWORD=
SEED_LUKE_PASSWORD=

# security
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT=60
LOGIN_RATE_LIMIT=5
RATE_LIMIT_ENABLED=true
LOGIN_TIMING_DEFENCE=true
SQLI_DEFENCE=true
ACCESS_CONTROL=true
MODEL_HASH_CHECK=true
BATCH_MAX_URLS=100
BATCH_CONCURRENCY=4