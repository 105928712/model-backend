    "/api/check/batch": {
      "post": {
        "summary": "Check Batch",
        "description": "Score up to 100 URLs at once, results in the same order as sent. Signed-in users get every check saved. Only 4 batches run at a time; when every slot is busy the server answers 503 with Retry-After...",
        "operationId": "check_batch_api_check_batch_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchRequest"
