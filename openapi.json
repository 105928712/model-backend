  "components": {
    "schemas": {
      "BatchRequest": {
        "properties": {
          "urls": {
            "items": {
              "type": "string",
              "maxLength": 2048,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Urls"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "urls"
        ],
        "title": "BatchRequest",
        "description": "Several URLs to check at once. One bad URL rejects the whole batch with HTTP 422 naming its position",
        "examples": [
          {
            "urls": [
              "google.com",
              "paypal-account-verify.top/login"
            ]
          }
        ]
      },
      "CheckRequest": {
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2048,
            "minLength": 1,
            "title": "Url"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "url"
        ],
        "title": "CheckRequest",
        "description": "A URL to check return HTTP 422 if bad",
        "examples": [
          {
            "url": "paypal-account-verify.top/login"
          }
        ]
      },
      "CheckResult": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "probability": {
            "type": "number",
            "title": "Probability"
          },
          "threshold": {
            "type": "number",
            "title": "Threshold"
          },
          "label": {
            "type": "string",
            "enum": [
              "phishing",
              "legitimate"
            ],
            "title": "Label"
          },
          "risk_band": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "title": "Risk Band"
          },
          "outside_training_domain": {
            "type": "boolean",
            "title": "Outside Training Domain"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "features": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "string"
                }
              ]
            },
            "type": "object",
            "title": "Features"
          }
        },
        "type": "object",
        "required": [
          "url",
          "model",
          "probability",
          "threshold",
          "label",
          "risk_band",
          "outside_training_domain",
          "warnings",
          "features"
        ],
        "title": "CheckResult",
        "description": "Everything known about one scored URL - return DTO for the front end",
        "examples": [
          {
            "features": {
              "...": "every extracted feature",
              "entropy": 4.13569955274647,
              "path_length": 6,
              "path_level": 1,
              "query_length": 0,
              "subdomain_count": 0
            },
            "label": "phishing",
            "model": "final_hgb",
            "outside_training_domain": false,
            "probability": 0.9999650084942906,
